{
  "name": "ed",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:site && npm run build:space && node scripts/merge-space-dist.js",
    "build:site": "tsc -b && node scripts/generate-sitemap.js && vite build",
    "build:space": "npm run build --workspace @entropydrop/space",
    "deploy:aws": "npm run build && node scripts/deploy-s3.js",
    "test:space": "npm test --workspace @entropydrop/space",
    "check:space": "npm run check --workspace @entropydrop/space",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@daidr/minecraft-skin-renderer": "^0.3.1",
    "@iconify-json/pixelarticons": "^1.2.5",
    "@iconify/react": "^6.0.2",
    "@mdxeditor/editor": "^4.0.2",
    "@react-oauth/google": "^0.13.4",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/three": "^0.183.1",
    "framer-motion": "^12.35.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "ts-proto": "^2.12.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
